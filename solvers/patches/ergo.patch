+### Makefile ---
+
+## Author: aign
+## Keywords:
+
+# main parameters
+CC       := cc
+CFLAGS   := -std=gnu99 -fPIC -Wall -fno-strict-aliasing
+COPT     := -O3 -DNDEBUG
